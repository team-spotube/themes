{
  "$schema": "https://docs.spotube.cc/schemas/theme/1.json",
  "schema": "1.3.0",
  "id": "newsprint",
  "version": "1.2.0",
  "author": "Spotube Team",
  "repository": "https://github.com/team-spotube/themes",
  "bugs": "https://github.com/team-spotube/themes/issues",
  "logo": "logo.png",
  "name": "Newsprint",
  "license": "AGPL-3.0-or-later",
  "description": "The Sunday paper: ink on cream (or a night edition), serif headlines, hairline rules and square corners.",
  "parameters": {
    "ink": {
      "type": "enum",
      "label": "Ink",
      "default": "black",
      "options": [
        {
          "value": "black",
          "label": "Black",
          "color": "#1a1a1a"
        },
        {
          "value": "red",
          "label": "Red",
          "color": "#b3261e"
        },
        {
          "value": "blue",
          "label": "Blue",
          "color": "#1d3f8a"
        },
        {
          "value": "green",
          "label": "Green",
          "color": "#1f5a3a"
        }
      ]
    }
  },
  "vars": {
    "none": {
      "type": "color",
      "default": "#00000000"
    },
    "ink": {
      "type": "color",
      "value": {
        "light": "#1b1a17",
        "dark": "#ece6d6"
      }
    },
    "spot": {
      "type": "color",
      "value": [
        "match",
        "{params.ink}",
        {
          "black": {
            "light": "#1a1a1a",
            "dark": "#ece6d6"
          },
          "red": {
            "light": "#b3261e",
            "dark": "#ff8a7a"
          },
          "blue": {
            "light": "#1d3f8a",
            "dark": "#9db8ff"
          },
          "green": {
            "light": "#1f5a3a",
            "dark": "#8fd6a8"
          }
        }
      ]
    },
    "onSpot": {
      "type": "color",
      "value": {
        "light": "#f4efe3",
        "dark": "#1c1a17"
      }
    },
    "paper": {
      "type": "color",
      "value": {
        "light": "#f4efe3",
        "dark": "#1c1a17"
      }
    },
    "paper2": {
      "type": "color",
      "value": {
        "light": "#ebe4d2",
        "dark": "#26231f"
      }
    },
    "paper3": {
      "type": "color",
      "value": {
        "light": "#e0d8c2",
        "dark": "#312d28"
      }
    },
    "dim": {
      "type": "color",
      "value": {
        "light": "#6a6354",
        "dark": "#a39b88"
      }
    },
    "tint": {
      "type": "color",
      "value": [
        "alpha",
        "{vars.spot}",
        0.1
      ]
    }
  },
  "tokens": {
    "color": {
      "background": "{vars.paper}",
      "surface": "{vars.paper2}",
      "raised": "{vars.paper3}",
      "inset": "{vars.paper2}",
      "text": "{vars.ink}",
      "muted": "{vars.dim}",
      "border": "{vars.ink}",
      "highlight": "#00000000",
      "accent": "{vars.spot}",
      "accentTop": "{vars.spot}",
      "accentBottom": "{vars.spot}",
      "onAccent": "{vars.onSpot}",
      "success": {
        "light": "#1f5a3a",
        "dark": "#8fd6a8"
      },
      "danger": {
        "light": "#b3261e",
        "dark": "#ff8a7a"
      },
      "scrim": {
        "light": "#1b1a1780",
        "dark": "#000000a0"
      }
    },
    "shape": {
      "small": 0,
      "medium": 0,
      "large": 0
    },
    "type": {
      "family": "Caladea",
      "styles": {
        "displaySmall": {
          "fontFamily": "DM Serif Display"
        },
        "headlineLarge": {
          "fontFamily": "DM Serif Display"
        },
        "headlineMedium": {
          "fontFamily": "DM Serif Display"
        },
        "headlineSmall": {
          "fontFamily": "DM Serif Display"
        },
        "titleLarge": {
          "fontFamily": "DM Serif Display"
        }
      }
    },
    "interaction": {
      "lighting": false
    },
    "surface": {
      "shadows": false,
      "glow": false
    },
    "app": {
      "background": [
        "gradient",
        "{vars.paper}",
        "{vars.paper}"
      ]
    }
  },
  "defaults": {
    "shape": "rect"
  },
