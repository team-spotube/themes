{
  "$schema": "https://docs.spotube.cc/schemas/theme/1.json",
  "schema": "1.0.0",
  "id": "phosphor",
  "version": "1.0.0",
  "author": "Spotube Team",
  "repository": "https://github.com/team-spotube/themes",
  "bugs": "https://github.com/team-spotube/themes/issues",
  "logo": "logo.png",
  "name": "Phosphor",
  "license": "AGPL-3.0-or-later",
  "description": "A terminal: monospace type, one-pixel outlines, no corners and inverse video for hover and selection. Dark is a CRT, light is paper.",
  "parameters": {
    "ink": {
      "type": "enum",
      "label": "Phosphor",
      "default": "green",
      "options": [
        {
          "value": "green",
          "label": "Green",
          "color": "#39ff6e"
        },
        {
          "value": "amber",
          "label": "Amber",
          "color": "#ffb000"
        },
        {
          "value": "ice",
          "label": "Ice",
          "color": "#7fe3ff"
        },
        {
          "value": "white",
          "label": "White",
          "color": "#e8f0e8"
        }
      ]
    }
  },
  "vars": {
    "none": {
      "type": "color",
      "default": "#00000000"
    },
    "ink": {
      "type": "color",
      "value": [
        "match",
        "{params.ink}",
        {
          "green": {
            "light": "#0f5a2a",
            "dark": "#39ff6e"
          },
          "amber": {
            "light": "#8a4b00",
            "dark": "#ffb000"
          },
          "ice": {
            "light": "#0b4f6c",
            "dark": "#7fe3ff"
          },
          "white": {
            "light": "#222222",
            "dark": "#e8f0e8"
          }
        }
      ]
    },
    "bg": {
      "type": "color",
      "value": {
        "light": "#f3f0df",
        "dark": "#000000"
      }
    },
    "dim": {
      "type": "color",
      "value": [
        "mix",
        "{vars.ink}",
        "{vars.bg}",
        0.5
      ]
    },
    "faint": {
      "type": "color",
      "value": [
        "alpha",
        "{vars.ink}",
        0.2
      ]
    },
    "glow": {
      "type": "color",
      "value": {
        "light": "#00000000",
        "dark": [
          "alpha",
          "{vars.ink}",
          0.6
        ]
      }
    }
  },
  "tokens": {
    "color": {
      "background": "{vars.bg}",
      "surface": "{vars.bg}",
      "raised": "{vars.bg}",
      "inset": "{vars.bg}",
      "text": "{vars.ink}",
      "muted": "{vars.dim}",
      "border": "{vars.ink}",
      "highlight": "#00000000",
      "accent": "{vars.ink}",
      "accentTop": "{vars.ink}",
      "accentBottom": "{vars.ink}",
      "onAccent": "{vars.bg}",
      "success": "{vars.ink}",
      "danger": {
        "light": "#b00020",
        "dark": "#ff5555"
      },
      "scrim": {
        "light": "#00000066",
        "dark": "#000000b0"
      }
    },
    "shape": {
      "small": 0,
      "medium": 0,
      "large": 0
    },
    "type": {
      "family": "VT323",
      "scale": 1.22
    },
    "interaction": {
      "lighting": false
    },
    "surface": {
      "shadows": false,
      "glow": false
    },
    "app": {
      "background": [
        "radial",
        0.5,
        0.45,
        1.05,
        {
          "light": "#f7f4e6",
          "dark": "#0a140c"
        },
        {
          "light": "#e7e3cf",
          "dark": "#000000"
        }
      ]
