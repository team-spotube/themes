{
  "schema": 1,
  "id": "metro",
  "name": "Metro",
  "version": "1.0.0",
  "author": "Spotube Team",
  "description": "Flat saturated tiles, big light typography, square corners and no chrome. Presses tilt the tile back.",
  "repository": "https://github.com/team-spotube/themes",
  "bugs": "https://github.com/team-spotube/themes/issues",
  "license": "AGPL-3.0-or-later",
  "logo": "logo.png",
  "parameters": {
    "accent": {
      "type": "enum",
      "label": "Accent",
      "default": "cobalt",
      "options": [
        {
          "value": "cobalt",
          "label": "Cobalt",
          "color": "#0078d7"
        },
        {
          "value": "magenta",
          "label": "Magenta",
          "color": "#d80073"
        },
        {
          "value": "lime",
          "label": "Lime",
          "color": "#60a917"
        },
        {
          "value": "orange",
          "label": "Orange",
          "color": "#fa6800"
        },
        {
          "value": "teal",
          "label": "Teal",
          "color": "#00aba9"
        },
        {
          "value": "crimson",
          "label": "Crimson",
          "color": "#a20025"
        }
      ]
    }
  },
  "vars": {
    "none": {
      "type": "color",
      "default": "#00000000"
    },
    "key": {
      "type": "color",
      "value": [
        "match",
        "{params.accent}",
        {
          "cobalt": "#0078d7",
          "magenta": "#d80073",
          "lime": "#60a917",
          "orange": "#fa6800",
          "teal": "#00aba9",
          "crimson": "#a20025"
        }
      ]
    },
    "keyHi": {
      "type": "color",
      "value": [
        "lighten",
        "{vars.key}",
        0.16
      ]
    },
    "page": {
      "type": "color",
      "value": {
        "light": "#ffffff",
        "dark": "#000000"
      }
    },
    "tile": {
      "type": "color",
      "value": {
        "light": "#e6e6e6",
        "dark": "#1f1f1f"
      }
    },
    "tileHi": {
      "type": "color",
      "value": {
        "light": "#d4d4d4",
        "dark": "#333333"
      }
    },
    "ink": {
      "type": "color",
      "value": {
        "light": "#000000",
        "dark": "#ffffff"
      }
    },
    "dim": {
      "type": "color",
      "value": {
        "light": "#666666",
        "dark": "#999999"
      }
    },
    "wash": {
      "type": "color",
      "value": [
        "alpha",
        "{vars.key}",
        0.18
      ]
    }
  },
  "tokens": {
    "color": {
      "background": "{vars.page}",
      "surface": "{vars.tile}",
      "raised": "{vars.tileHi}",
      "inset": "{vars.tile}",
      "text": "{vars.ink}",
      "muted": "{vars.dim}",
      "border": "{vars.dim}",
      "highlight": "#00000000",
      "accent": "{vars.key}",
      "accentTop": "{vars.key}",
      "accentBottom": "{vars.key}",
      "onAccent": "#ffffff",
      "success": "#60a917",
      "danger": "#e51400",
      "scrim": {
        "light": "#ffffffb0",
        "dark": "#000000b0"
      }
    },
    "shape": {
      "small": 0,
      "medium": 0,
      "large": 0
