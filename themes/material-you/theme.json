{
  "schema": 1,
  "id": "material-you",
  "name": "You",
  "version": "1.0.0",
  "author": "Spotube Team",
  "description": "Tonal, softly rounded surfaces tinted by your accent: pill buttons, stadium selection and a roomy layout.",
  "repository": "https://github.com/team-spotube/themes",
  "bugs": "https://github.com/team-spotube/themes/issues",
  "license": "AGPL-3.0-or-later",
  "logo": "logo.png",
  "parameters": {
    "tone": {
      "type": "enum",
      "label": "Color",
      "default": "violet",
      "options": [
        {
          "value": "violet",
          "label": "Violet",
          "color": "#6750a4"
        },
        {
          "value": "blue",
          "label": "Blue",
          "color": "#1a73e8"
        },
        {
          "value": "green",
          "label": "Green",
          "color": "#2e7d32"
        },
        {
          "value": "rose",
          "label": "Rose",
          "color": "#b3261e"
        },
        {
          "value": "amber",
          "label": "Amber",
          "color": "#b26a00"
        }
      ]
    },
    "shape": {
      "type": "enum",
      "label": "Corners",
      "default": "round",
      "options": [
        {
          "value": "round",
          "label": "Round"
        },
        {
          "value": "sharp",
          "label": "Sharp"
        }
      ]
    }
  },
  "vars": {
    "none": {
      "type": "color",
      "default": "#00000000"
    },
    "key": {
      "type": "color",
      "value": [
        "match",
        "{params.tone}",
        {
          "violet": {
            "light": "#6750a4",
            "dark": "#d0bcff"
          },
          "blue": {
            "light": "#1a5fc9",
            "dark": "#a8c7fa"
          },
          "green": {
            "light": "#2e7d32",
            "dark": "#a6d6a0"
          },
          "rose": {
            "light": "#b3261e",
            "dark": "#ffb4ab"
          },
          "amber": {
            "light": "#8a5100",
            "dark": "#ffb869"
          }
        }
      ]
    },
    "onKey": {
      "type": "color",
      "value": [
        "match",
        "{params.tone}",
        {
          "violet": {
            "light": "#ffffff",
            "dark": "#381e72"
          },
          "blue": {
            "light": "#ffffff",
            "dark": "#062e6f"
          },
          "green": {
            "light": "#ffffff",
            "dark": "#0c3b10"
          },
          "rose": {
            "light": "#ffffff",
            "dark": "#601410"
          },
          "amber": {
            "light": "#ffffff",
            "dark": "#4a2800"
          }
        }
      ]
    },
    "tonal": {
      "type": "color",
      "value": [
        "match",
        "{params.tone}",
        {
          "violet": {
            "light": "#e8def8",
            "dark": "#4a4458"
          },
          "blue": {
            "light": "#d3e3fd",
            "dark": "#2f4a76"
          },
          "green": {
            "light": "#cdebc8",
            "dark": "#34513a"
          },
          "rose": {
            "light": "#ffdad6",
            "dark": "#7a2a25"
          },
          "amber": {
            "light": "#ffddb8",
            "dark": "#5c4021"
          }
        }
      ]
    },
    "onTonal": {
      "type": "color",
      "value": [
        "match",
        "{params.tone}",
        {
          "violet": {
            "light": "#1d192b",
            "dark": "#e8def8"
          },
          "blue": {
            "light": "#041e49",
            "dark": "#d3e3fd"
          },
          "green": {
            "light": "#0a2e10",
            "dark": "#cdebc8"
          },
          "rose": {
            "light": "#410e0b",
            "dark": "#ffdad6"
          },
          "amber": {
            "light": "#2b1700",
            "dark": "#ffddb8"
          }
        }
      ]
    },
    "page": {
      "type": "color",
      "value": [
        "match",
        "{params.tone}",
        {
          "violet": {
            "light": "#fef7ff",
            "dark": "#141218"
          },
          "blue": {
            "light": "#f8f9ff",
            "dark": "#111318"
          },
          "green": {
            "light": "#f7fbf1",
            "dark": "#10140f"
          },
          "rose": {
            "light": "#fffbff",
            "dark": "#1a1110"
          },
          "amber": {
            "light": "#fffbff",
            "dark": "#18120c"
          }
        }
      ]
    },
    "panel": {
      "type": "color",
      "value": [
        "match",
        "{params.tone}",
        {
          "violet": {
            "light": "#f3edf7",
            "dark": "#211f26"
          },
          "blue": {
            "light": "#eceef4",
            "dark": "#1d2024"
          },
          "green": {
            "light": "#ebefe5",
            "dark": "#1c201b"
          },
          "rose": {
            "light": "#f9ecea",
            "dark": "#271d1c"
          },
          "amber": {
            "light": "#f6ebe0",
            "dark": "#241d15"
          }
        }
      ]
    },
    "panelHi": {
      "type": "color",
      "value": [
        "match",
        "{params.tone}",
        {
          "violet": {
            "light": "#ece6f0",
            "dark": "#2b2930"
          },
          "blue": {
            "light": "#e1e3e9",
            "dark": "#282a2f"
          },
          "green": {
            "light": "#e0e4da",
            "dark": "#262a25"
          },
          "rose": {
            "light": "#f2e2df",
            "dark": "#322826"
          },
          "amber": {
            "light": "#ecdfd2",
            "dark": "#2f271e"
          }
        }
      ]
    },
    "ink": {
      "type": "color",
      "value": {
        "light": "#1d1b20",
        "dark": "#e6e0e9"
      }
    },
    "inkDim": {
      "type": "color",
      "value": {
        "light": "#49454f",
        "dark": "#cac4d0"
      }
    },
    "outline": {
      "type": "color",
      "value": {
        "light": "#79747e",
        "dark": "#938f99"
      }
    },
    "state": {
      "type": "color",
      "value": [
        "alpha",
        "{vars.onTonal}",
        0.1
      ]
    },
    "r": {
      "type": "number",
      "value": [
        "match",
        "{params.shape}",
        {
          "round": 20,
          "sharp": 6
        }
      ]
    },
    "rCtl": {
      "type": "number",
      "value": [
        "match",
        "{params.shape}",
        {
          "round": 100,
          "sharp": 6
        }
      ]
    }
  },
  "tokens": {
    "color": {
      "background": "{vars.page}",
      "surface": "{vars.panel}",
      "raised": "{vars.panelHi}",
      "inset": "{vars.panelHi}",
      "text": "{vars.ink}",
      "muted": "{vars.inkDim}",
      "border": "{vars.outline}",
      "highlight": "#00000000",
      "accent": "{vars.key}",
      "accentTop": "{vars.key}",
      "accentBottom": "{vars.key}",
      "onAccent": "{vars.onKey}",
      "success": {
        "light": "#1b6e2d",
        "dark": "#8fd69a"
      },
      "danger": {
        "light": "#b3261e",
        "dark": "#f2b8b5"
      },
      "scrim": "#00000066"
    },
    "shape": {
      "small": 10,
      "medium": 16,
      "large": 28
    },
    "type": {
      "family": "Red Hat Text"
    },
    "interaction": {
      "lighting": false
    },
    "surface": {
      "shadows": false,
      "glow": false
    },
    "app": {
      "background": [
        "linear",
        180,
        "{vars.page}",
        "{vars.page}"
      ]
    }
  },
  "defaults": {
    "shape": "{vars.r}"
  },
