          "light": "#f8f0ff",
          "dark": "#0a0518"
        },
        {
          "light": "#e9d7ff",
          "dark": "#1a0b3a"
        },
        {
          "light": "#ffd9ef",
          "dark": "#3a0f4f"
        }
      ]
    }
  },
