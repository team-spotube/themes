{
  "schema": 1,
  "id": "neon-noir",
  "name": "Neon Noir",
  "version": "2.0.0",
  "author": "Spotube Team",
  "description": "Synthwave after dark: a sunset-gradient backdrop, neon tubes around outlines, glowing headings and an Audiowide wordmark feel. Light is a pastel daylight take.",
  "repository": "https://github.com/team-spotube/themes",
  "bugs": "https://github.com/team-spotube/themes/issues",
  "license": "AGPL-3.0-or-later",
  "logo": "logo.png",
  "parameters": {
    "neon": {
      "type": "enum",
      "label": "Neon",
      "default": "pink",
      "options": [
        {
          "value": "pink",
          "label": "Pink",
          "color": "#ff3da6"
        },
        {
          "value": "cyan",
          "label": "Cyan",
          "color": "#2ee6ff"
        },
        {
          "value": "lime",
          "label": "Lime",
          "color": "#a3e635"
        },
        {
          "value": "amber",
          "label": "Amber",
          "color": "#ffb020"
        }
      ]
    },
    "glow": {
      "type": "number",
      "label": "Glow",
      "default": 0.6,
      "min": 0,
      "max": 1,
      "step": 0.1
    }
  },
  "vars": {
    "none": {
      "type": "color",
      "default": "#00000000"
    },
    "neon": {
      "type": "color",
      "value": [
        "match",
        "{params.neon}",
        {
          "pink": {
            "light": "#d6177f",
            "dark": "#ff3da6"
          },
          "cyan": {
            "light": "#0891b2",
            "dark": "#2ee6ff"
          },
          "lime": {
            "light": "#4d7c0f",
            "dark": "#a3e635"
          },
          "amber": {
            "light": "#b45309",
            "dark": "#ffb020"
          }
        }
      ]
    },
    "neonHi": {
      "type": "color",
      "value": [
        "match",
        "{params.neon}",
        {
          "pink": "#ff7ac6",
          "cyan": "#7ff3ff",
          "lime": "#d9ff6a",
          "amber": "#ffd36a"
        }
      ]
    },
    "neonLo": {
      "type": "color",
      "value": [
        "match",
        "{params.neon}",
        {
          "pink": "#7b2ff7",
          "cyan": "#2563eb",
          "lime": "#16a34a",
          "amber": "#ef4444"
        }
      ]
    },
    "twin": {
      "type": "color",
      "value": [
        "match",
        "{params.neon}",
        {
          "pink": {
            "light": "#0891b2",
            "dark": "#2ee6ff"
          },
          "cyan": {
            "light": "#d6177f",
            "dark": "#ff3da6"
          },
          "lime": {
            "light": "#0891b2",
            "dark": "#2ee6ff"
          },
          "amber": {
            "light": "#7c3aed",
            "dark": "#b794ff"
          }
        }
      ]
    },
    "halo": {
      "type": "color",
      "value": [
        "alpha",
        "{vars.neon}",
        [
          "mul",
          "{params.glow}",
          0.95
        ]
      ]
    },
    "haloSoft": {
      "type": "color",
      "value": [
        "alpha",
        "{vars.neon}",
        [
          "mul",
          "{params.glow}",
          0.35
        ]
      ]
    },
    "twinHalo": {
      "type": "color",
      "value": [
        "alpha",
        "{vars.twin}",
        [
          "mul",
          "{params.glow}",
          0.6
        ]
      ]
    },
    "ink": {
      "type": "color",
      "value": {
        "light": "#2a1245",
        "dark": "#f6f0ff"
      }
    },
    "dim": {
      "type": "color",
      "value": {
        "light": "#6b5a86",
        "dark": "#a99bc7"
      }
    },
    "deep": {
      "type": "color",
      "value": {
        "light": "#f4ecff",
        "dark": "#0b0614"
      }
    },
    "pane": {
      "type": "color",
      "value": {
        "light": "#ffffffe6",
        "dark": "#150d28e6"
      }
    },
    "pane2": {
      "type": "color",
      "value": {
        "light": "#f1e6ff",
        "dark": "#1f1438"
      }
    },
    "line": {
      "type": "color",
      "value": {
        "light": "#cdb6ee",
        "dark": "#3b2a63"
      }
    },
    "wash": {
      "type": "color",
      "value": [
        "alpha",
        "{vars.neon}",
        0.16
      ]
    }
  },
  "tokens": {
    "color": {
      "background": "{vars.deep}",
      "surface": "{vars.pane}",
      "raised": "{vars.pane2}",
      "inset": {
        "light": "#ebdfff",
        "dark": "#090411"
      },
      "text": "{vars.ink}",
      "muted": "{vars.dim}",
      "border": "{vars.line}",
      "highlight": "#ffffff30",
      "accent": "{vars.neon}",
      "accentTop": "{vars.neonHi}",
      "accentBottom": "{vars.neonLo}",
      "onAccent": "#ffffff",
      "success": "#4dffb0",
      "danger": "#ff5470",
      "scrim": {
        "light": "#2a124570",
        "dark": "#05020ac0"
      }
    },
    "shape": {
      "small": 8,
      "medium": 14,
      "large": 22
    },
    "type": {
      "family": "Chakra Petch",
      "styles": {
        "displaySmall": {
          "fontFamily": "Audiowide"
        },
        "headlineLarge": {
          "fontFamily": "Audiowide"
        },
        "headlineMedium": {
