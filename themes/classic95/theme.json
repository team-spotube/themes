        "borderWidth": 1,
        "borderColor": "{vars.frame}",
        "innerGlowColor": "{vars.lit}",
        "bottomRimColor": "{vars.shade}",
        "shadows": [
          "#00000000"
        ],
        "shadowElevation": 0,
        "interactionOverlay": "#00000000",
        "interactionRim": "#00000000",
        "motion": {
          "hoverScale": 1,
          "pressedScale": 1
        },
        "labelShadow": false,
        "shape": "rect",
        "foreground": "{vars.ink}",
        "textStyle": {
          "fontWeight": 400
        },
        "padding": [
          14,
          6
        ]
      },
      "states": {
        "pressed": {
          "background": [
            "gradient",
            "{vars.faceDown}",
            "{vars.faceDown}"
          ],
          "borderWidth": 1,
          "borderColor": "{vars.frame}",
          "innerGlowColor": "#00000000",
          "bottomRimColor": null
        },
        "focused": {
          "borderColor": "{vars.ink}",
          "borderWidth": 2
        },
        "disabled": {
