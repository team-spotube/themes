        }
      },
      "variants": {
        "primary": {
          "base": {
            "borderColor": "{vars.ink}",
            "borderWidth": 2,
            "textStyle": {
              "fontWeight": 700
            }
          }
        },
        "secondary": {},
        "quiet": {
          "base": {
