          "states": {
            "hovered": {
              "background": [
                "gradient",
                "{vars.face}",
                "{vars.face}"
              ],
              "borderWidth": 1,
              "borderColor": "{vars.frame}",
              "innerGlowColor": "{vars.lit}",
              "bottomRimColor": "{vars.shade}"
            }
          }
        },
        "danger": {
          "base": {
            "foreground": "{vars.bad}",
            "textStyle": {
              "fontWeight": 700
            }
          }
        }
      }
    },
    "iconButton": {
