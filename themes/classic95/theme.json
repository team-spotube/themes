{
  "$schema": "https://docs.spotube.cc/schemas/theme/1.json",
  "schema": "1.0.0",
  "id": "classic95",
  "version": "1.0.0",
  "author": "Spotube Team",
  "repository": "https://github.com/team-spotube/themes",
  "bugs": "https://github.com/team-spotube/themes/issues",
  "logo": "logo.png",
  "name": "Classic",
  "license": "AGPL-3.0-or-later",
  "description": "A 1990s desktop: square grey bevels, navy title bars and menu highlights, and no animation to speak of.",
  "parameters": {
    "desktop": {
      "type": "enum",
      "label": "Highlight",
      "default": "navy",
      "options": [
        {
          "value": "navy",
          "label": "Navy",
          "color": "#000080"
        },
        {
          "value": "teal",
          "label": "Teal",
          "color": "#008080"
        },
        {
          "value": "maroon",
          "label": "Maroon",
          "color": "#800000"
        },
        {
          "value": "olive",
          "label": "Olive",
          "color": "#808000"
        }
      ]
    },
    "density": {
      "type": "enum",
      "label": "Row size",
      "default": "normal",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "normal",
          "label": "Normal"
        }
      ]
    }
  },
  "vars": {
    "none": {
      "type": "color",
      "default": "#00000000"
    },
    "face": {
      "type": "color",
      "value": {
        "light": "#c0c0c0",
        "dark": "#3c3c3c"
      }
    },
    "faceDown": {
      "type": "color",
      "value": {
        "light": "#b0b0b0",
        "dark": "#303030"
      }
    },
    "field": {
      "type": "color",
      "value": {
        "light": "#ffffff",
        "dark": "#1a1a1a"
      }
    },
    "ink": {
      "type": "color",
      "value": {
        "light": "#000000",
        "dark": "#e8e8e8"
      }
    },
    "inkOff": {
      "type": "color",
      "value": {
        "light": "#808080",
        "dark": "#808080"
      }
    },
    "lit": {
      "type": "color",
      "value": {
        "light": "#ffffff",
        "dark": "#6a6a6a"
      }
    },
    "shade": {
      "type": "color",
      "value": {
        "light": "#808080",
        "dark": "#141414"
      }
    },
    "bad": {
      "type": "color",
      "value": {
        "light": "#c00000",
        "dark": "#ff6a6a"
      }
    },
    "frame": {
      "type": "color",
      "value": {
        "light": "#404040",
        "dark": "#000000"
      }
    },
    "hi": {
      "type": "color",
      "value": [
        "match",
        "{params.desktop}",
        {
          "navy": "#000080",
          "teal": "#008080",
          "maroon": "#800000",
          "olive": "#6b6b00"
        }
      ]
    },
    "hiEdge": {
      "type": "color",
      "value": [
        "match",
        "{params.desktop}",
        {
          "navy": "#1084d0",
          "teal": "#30c0c0",
          "maroon": "#c04040",
          "olive": "#b0b000"
        }
      ]
    },
    "rowH": {
      "type": "number",
      "value": [
        "match",
        "{params.density}",
        {
          "compact": 28,
          "normal": 36
        }
      ]
    }
  },
  "tokens": {
    "color": {
      "background": "{vars.face}",
      "surface": "{vars.face}",
      "raised": "{vars.face}",
      "inset": "{vars.field}",
      "text": "{vars.ink}",
      "muted": "{vars.inkOff}",
      "border": "{vars.frame}",
      "highlight": "{vars.lit}",
      "accent": "{vars.hi}",
      "accentTop": "{vars.hiEdge}",
      "accentBottom": "{vars.hi}",
      "onAccent": "#ffffff",
      "success": "#008000",
      "danger": "{vars.bad}",
      "scrim": "#00000040"
    },
    "shape": {
      "small": 0,
      "medium": 0,
      "large": 0
    },
    "type": {
      "family": "Liberation Sans"
    },
    "interaction": {
      "lighting": false
    },
    "app": {
      "background": [
        "gradient",
        "{vars.face}",
        "{vars.face}"
      ]
    }
  },
  "defaults": {
    "shape": "rect"
  },
  "components": {
    "button": {
      "base": {
        "background": [
          "gradient",
          "{vars.face}",
          "{vars.face}"
