{
  "schema": 1,
  "id": "dracula",
  "name": "Dracula",
  "version": "1.0.0",
  "author": "Spotube Team",
  "description": "The classic dark theme with vivid purple and pink, and its light sibling Alucard.",
  "parameters": {
    "accent": {
      "type": "enum",
      "label": "Accent color",
      "default": "purple",
      "options": [
        {
          "value": "purple",
          "label": "Purple",
          "color": "#bd93f9"
        },
        {
          "value": "pink",
          "label": "Pink",
          "color": "#ff79c6"
        },
        {
          "value": "cyan",
          "label": "Cyan",
          "color": "#8be9fd"
        },
        {
          "value": "green",
          "label": "Green",
          "color": "#50fa7b"
        },
        {
          "value": "orange",
          "label": "Orange",
          "color": "#ffb86c"
        },
        {
          "value": "yellow",
          "label": "Yellow",
          "color": "#f1fa8c"
        }
      ]
    },
    "radius": {
      "type": "number",
      "label": "Corner radius",
      "default": 8,
      "min": 0,
      "max": 16,
      "step": 1
    },
    "density": {
      "type": "enum",
      "label": "Density",
      "default": "comfortable",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "comfortable",
          "label": "Comfortable"
        },
        {
          "value": "spacious",
          "label": "Spacious"
        }
      ]
    }
  },
  "vars": {
    "none": {
      "type": "color",
      "default": "#00000000"
    },
    "r": {
      "type": "number",
      "value": "{params.radius}"
    },
    "rSm": {
      "type": "number",
      "value": [
        "max",
        0,
        [
          "sub",
          "{params.radius}",
          2
        ]
      ]
    },
    "rLg": {
      "type": "number",
      "value": [
        "add",
        "{params.radius}",
        2
      ]
    },
    "rXl": {
      "type": "number",
      "value": [
        "add",
        "{params.radius}",
        6
      ]
    },
    "padH": {
      "type": "number",
      "value": [
        "match",
        "{params.density}",
        {
          "compact": 12,
          "comfortable": 16,
          "spacious": 20
        }
      ]
    },
    "padV": {
      "type": "number",
      "value": [
        "match",
        "{params.density}",
        {
          "compact": 6,
          "comfortable": 8,
          "spacious": 12
        }
      ]
    },
    "ctl": {
      "type": "number",
      "value": [
        "match",
        "{params.density}",
        {
          "compact": 34,
          "comfortable": 40,
          "spacious": 48
        }
      ]
    },
    "rowH": {
      "type": "number",
      "value": [
        "match",
        "{params.density}",
        {
          "compact": 44,
          "comfortable": 56,
          "spacious": 68
        }
      ]
    },
    "rowPadH": {
      "type": "number",
      "value": [
        "match",
        "{params.density}",
        {
          "compact": 10,
          "comfortable": 14,
          "spacious": 18
        }
      ]
    },
    "rowPadV": {
      "type": "number",
      "value": [
        "match",
        "{params.density}",
        {
          "compact": 6,
          "comfortable": 10,
          "spacious": 14
        }
      ]
    },
    "bg": {
      "type": "color",
      "value": {
        "light": "#fffbeb",
        "dark": "#282a36"
      }
    },
    "fg": {
      "type": "color",
      "value": {
        "light": "#1f1f1f",
        "dark": "#f8f8f2"
      }
    },
    "muted": {
      "type": "color",
      "value": {
        "light": "#f1ecd8",
        "dark": "#343746"
      }
    },
    "mutedFg": {
      "type": "color",
      "value": {
        "light": "#6c664b",
        "dark": "#a4abd0"
      }
    },
    "border": {
      "type": "color",
      "value": {
        "light": "#cfcfde",
        "dark": "#44475a"
      }
    },
    "primary": {
      "type": "color",
      "value": [
        "match",
        "{params.accent}",
        {
          "purple": {
            "light": "#644ac9",
            "dark": "#bd93f9"
          },
          "pink": {
            "light": "#a3144d",
            "dark": "#ff79c6"
          },
          "cyan": {
            "light": "#036a96",
            "dark": "#8be9fd"
          },
          "green": {
            "light": "#14710a",
            "dark": "#50fa7b"
          },
          "orange": {
            "light": "#a34d14",
            "dark": "#ffb86c"
          },
          "yellow": {
            "light": "#846e15",
            "dark": "#f1fa8c"
          }
        }
      ]
    },
    "primaryFg": {
      "type": "color",
      "value": [
        "match",
        "{params.accent}",
        {
          "purple": {
            "light": "#ffffff",
            "dark": "#282a36"
          },
          "pink": {
            "light": "#ffffff",
            "dark": "#282a36"
          },
          "cyan": {
            "light": "#ffffff",
            "dark": "#282a36"
          },
          "green": {
            "light": "#ffffff",
            "dark": "#282a36"
          },
          "orange": {
            "light": "#ffffff",
            "dark": "#282a36"
          },
          "yellow": {
            "light": "#ffffff",
            "dark": "#282a36"
          }
        }
      ]
    },
    "primaryHover": {
      "type": "color",
      "value": [
        "alpha",
        "{vars.primary}",
        0.9
      ]
    },
    "destructive": {
      "type": "color",
      "value": {
        "light": "#cb3a2a",
        "dark": "#ff5555"
      }
    },
    "destructiveFg": {
      "type": "color",
      "value": {
        "light": "#ffffff",
        "dark": "#ffffff"
      }
    },
    "destructiveHover": {
      "type": "color",
      "value": [
        "alpha",
        "{vars.destructive}",
        0.9
      ]
    },
    "ring": {
      "type": "color",
      "value": [
        "match",
        "{params.accent}",
        {
          "purple": {
            "light": "#644ac9",
            "dark": "#bd93f9"
          },
          "pink": {
            "light": "#a3144d",
            "dark": "#ff79c6"
          },
          "cyan": {
            "light": "#036a96",
            "dark": "#8be9fd"
          },
          "green": {
            "light": "#14710a",
            "dark": "#50fa7b"
          },
          "orange": {
            "light": "#a34d14",
            "dark": "#ffb86c"
          },
          "yellow": {
            "light": "#846e15",
            "dark": "#f1fa8c"
          }
        }
      ]
    },
    "wash": {
      "type": "color",
      "value": {
        "light": "#0000000d",
        "dark": "#ffffff14"
      }
    },
    "shadow": {
      "type": "color",
      "value": {
        "light": "#0000001a",
        "dark": "#00000080"
      }
    },
    "card": {
      "type": "color",
      "value": {
        "light": "#fffef5",
        "dark": "#21222c"
      }
    }
  },
  "tokens": {
    "color": {
      "background": "{vars.bg}",
      "surface": "{vars.card}",
      "inset": "{vars.muted}",
      "raised": {
        "light": "#ffffff",
        "dark": "#343746"
      },
      "text": "{vars.fg}",
      "muted": "{vars.mutedFg}",
      "border": "{vars.border}",
      "highlight": "{vars.none}",
      "accent": "{vars.primary}",
      "accentTop": "{vars.primary}",
      "accentBottom": "{vars.primary}",
      "onAccent": "{vars.primaryFg}",
      "success": {
        "light": "#14710a",
        "dark": "#50fa7b"
      },
      "danger": {
        "light": "#cb3a2a",
        "dark": "#ff5555"
      },
      "scrim": {
        "light": "#00000066",
        "dark": "#00000099"
      }
    },
    "shape": {
      "small": "{vars.rSm}",
      "medium": "{vars.r}",
      "large": "{vars.rLg}"
    },
    "interaction": {
      "lighting": false
    },
    "surface": {
      "shadows": false,
      "glow": false
    }
  },
  "defaults": {
    "shape": "{vars.r}",
    "innerGlowColor": "{vars.none}",
    "bottomRimColor": null
  },
  "components": {
    "button": {
      "base": {
        "borderWidth": 0,
        "shadows": [
          "{vars.none}"
        ],
        "shadowElevation": 0,
        "minSize": [
          40,
          "{vars.ctl}"
        ],
        "padding": [
          "{vars.padH}",
          "{vars.padV}"
        ],
        "interactionOverlay": "{vars.none}",
        "interactionRim": "{vars.none}",
        "labelShadow": false,
        "motion": {
          "hoverScale": 1,
          "pressedScale": 1
        },
        "textStyle": {
          "fontSize": 14,
          "lineHeight": 20,
          "fontWeight": 500
        }
      },
      "states": {
        "focused": {
          "borderWidth": 2
        },
        "disabled": {
          "alpha": 0.5
        }
      },
      "variants": {
        "primary": {
          "base": {
            "background": "{vars.primary}",
            "foreground": "{vars.primaryFg}",
            "borderColor": "{vars.none}"
          },
          "states": {
            "hovered": {
              "background": "{vars.primaryHover}"
            },
            "pressed": {
              "background": "{vars.primaryHover}"
            },
            "focused": {
              "borderColor": "{vars.ring}"
            }
          }
        },
        "secondary": {
          "base": {
            "background": "{vars.bg}",
            "foreground": "{vars.fg}",
            "borderWidth": 1,
            "borderColor": "{vars.border}"
          },
          "states": {
            "hovered": {
              "background": "{vars.muted}"
            },
            "pressed": {
              "background": "{vars.muted}"
            },
            "focused": {
              "borderColor": "{vars.ring}",
              "borderWidth": 2
            }
          }
        },
        "quiet": {
          "base": {
            "background": "{vars.none}",
            "foreground": "{vars.fg}",
            "borderColor": "{vars.none}"
          },
          "states": {
            "hovered": {
              "background": "{vars.muted}",
              "borderWidth": 0
            },
            "pressed": {
              "background": "{vars.muted}",
              "borderWidth": 0
            },
            "focused": {
              "borderColor": "{vars.ring}"
            }
          }
        },
        "danger": {
          "base": {
            "background": "{vars.destructive}",
            "foreground": "{vars.destructiveFg}",
            "borderColor": "{vars.none}"
          },
          "states": {
            "hovered": {
              "background": "{vars.destructiveHover}"
            },
            "pressed": {
              "background": "{vars.destructiveHover}"
            },
            "focused": {
              "borderColor": "{vars.ring}"
            }
          }
        }
      }
    },
    "iconButton": {
      "base": {
        "orb": false,
        "borderWidth": 0,
        "shadows": [
          "{vars.none}"
        ],
        "shadowElevation": 0,
        "iconSize": 16,
        "interactionOverlay": "{vars.none}",
        "interactionRim": "{vars.none}",
        "motion": {
          "hoverScale": 1,
          "pressedScale": 1
        }
      },
      "states": {
        "focused": {
          "borderWidth": 2,
          "borderColor": "{vars.ring}"
        },
        "disabled": {
          "alpha": 0.5
        }
      },
      "variants": {
        "primary": {
          "base": {
            "background": "{vars.primary}",
            "foreground": "{vars.primaryFg}"
          },
          "states": {
            "hovered": {
              "background": "{vars.primaryHover}"
            }
          }
        },
        "secondary": {
          "base": {
            "background": "{vars.bg}",
            "foreground": "{vars.fg}",
            "borderWidth": 1,
            "borderColor": "{vars.border}"
          },
          "states": {
            "hovered": {
              "background": "{vars.muted}"
            }
          }
        },
        "quiet": {
          "base": {
            "background": "{vars.none}",
            "foreground": "{vars.fg}"
          },
          "states": {
            "hovered": {
              "background": "{vars.muted}"
            }
          }
        },
        "danger": {
          "base": {
            "background": "{vars.destructive}",
            "foreground": "{vars.destructiveFg}"
          },
          "states": {
            "hovered": {
              "background": "{vars.destructiveHover}"
            }
          }
        }
      }
    },
    "toggleSwitch": {
      "base": {
        "trackSize": [
          44,
          24
        ],
        "trackShape": "pill",
        "thumbShape": "pill",
        "trackBackground": "{vars.border}",
        "selectedTrackBackground": "{vars.primary}",
        "trackBorderColor": "{vars.none}",
        "trackGlowColor": "{vars.none}",
        "trackBottomRimColor": null,
        "thumbBackground": "{vars.bg}",
        "thumbBorderColor": "{vars.none}",
        "thumbGlowColor": "{vars.none}",
        "thumbBottomRimColor": null,
        "thumbElevation": 0,
        "trackInteractionOverlay": "{vars.none}",
        "thumbInteractionOverlay": "{vars.none}",
        "thumbHoverScaleX": 1,
        "thumbHoverScaleY": 1,
        "thumbPressedScaleX": 1,
        "thumbPressedScaleY": 1
      },
      "states": {
        "disabled": {
          "alpha": 0.5
        },
        "focused": {
          "trackBorderColor": "{vars.ring}"
        }
      }
    },
    "checkbox": {
      "base": {
        "faceShape": "{vars.rSm}",
        "faceSize": [
          16,
          16
        ],
        "faceBackground": "{vars.bg}",
        "faceBorderColor": "{vars.primary}",
        "faceBorderWidth": 1,
        "selectedFaceBackground": "{vars.primary}",
        "selectedFaceBorderColor": "{vars.primary}",
        "selectedFaceForeground": "{vars.primaryFg}",
        "faceGlowColor": "{vars.none}",
        "selectedFaceGlowColor": "{vars.none}",
        "faceElevation": 0,
        "faceBottomRimColor": null,
        "faceInteractionOverlay": "{vars.none}",
        "faceHoverScale": 1,
        "facePressedScale": 1
      },
      "states": {
        "disabled": {
          "faceAlpha": 0.5
        },
        "focused": {
          "faceBorderColor": "{vars.ring}",
          "faceBorderWidth": 2
        }
      }
    },
    "slider": {
      "base": {
        "trackBackground": "{vars.muted}",
        "trackBorderColor": "{vars.none}",
        "trackInsetShadeColor": "{vars.none}",
        "trackShape": "pill",
        "trackInnerGlowColor": "{vars.none}",
        "trackBottomRimColor": null,
        "activeTrackBackground": "{vars.primary}",
        "activeTrackShape": "pill",
        "activeTrackGlowColor": "{vars.none}",
        "thumbBackground": "{vars.bg}",
        "thumbBorderColor": "{vars.primary}",
        "thumbBorderWidth": 2,
        "thumbShape": "pill",
        "thumbGlowColor": "{vars.none}",
        "thumbBottomRimColor": null,
        "thumbElevation": 0,
        "trackInteractionOverlay": "{vars.none}",
        "thumbInteractionOverlay": "{vars.none}"
      },
      "states": {
        "disabled": {
          "alpha": 0.5
        }
      }
    },
    "progress": {
      "base": {
        "shape": "pill",
        "height": 8,
        "trackBackground": "{vars.muted}",
        "borderColor": "{vars.none}",
        "borderWidth": 0,
        "progressBackground": "{vars.primary}",
        "progressShape": "pill",
        "progressInnerGlowColor": "{vars.none}",
        "progressBottomRimColor": null,
        "trackBottomRimColor": null
      }
    },
    "textField": {
      "base": {
        "background": "{vars.bg}",
        "borderColor": "{vars.border}",
        "borderWidth": 1,
        "shape": "{vars.r}",
        "minimumHeight": "{vars.ctl}",
        "insetShadeColor": "{vars.none}",
        "cursorColor": "{vars.fg}",
        "interactionOverlay": "{vars.none}",
        "placeholderColor": "{vars.mutedFg}",
        "labelColor": "{vars.fg}"
      },
      "states": {
        "focused": {
          "borderColor": "{vars.ring}",
          "borderWidth": 2
        },
        "disabled": {
          "alpha": 0.5
        }
      }
    },
    "card": {
      "base": {
        "shape": "{vars.rXl}",
        "background": "{vars.card}",
        "borderColor": "{vars.border}",
        "borderWidth": 1,
        "shadowElevation": 1,
        "shadowColor": "{vars.shadow}",
        "insetShadeColor": "{vars.none}",
        "interactionOverlay": "{vars.none}"
      }
    },
    "listTile": {
      "base": {
        "shape": "{vars.r}",
        "contentPadding": [
          "{vars.rowPadH}",
          "{vars.rowPadV}"
        ],
        "minimumHeight": "{vars.rowH}",
        "background": "{vars.none}",
        "selectedBackground": "{vars.muted}",
        "borderWidth": 0,
        "shadowElevation": 0,
        "titleForeground": "{vars.fg}",
        "subtitleForeground": "{vars.mutedFg}",
        "selectedTitleForeground": "{vars.fg}",
        "selectedSubtitleForeground": "{vars.mutedFg}",
        "interactionOverlay": "{vars.none}"
      },
      "states": {
        "hovered": {
          "interactionOverlay": [
            "gradient",
            "{vars.wash}",
            "{vars.wash}"
          ]
        },
        "pressed": {
          "interactionOverlay": [
            "gradient",
            "{vars.wash}",
            "{vars.wash}"
          ]
        },
        "focused": {
          "interactionOverlay": [
            "gradient",
            "{vars.wash}",
            "{vars.wash}"
          ]
        }
      }
    },
    "icon": {
      "base": {
        "size": 16
      }
    },
    "separator": {
      "base": {
        "color": "{vars.border}",
        "highlightColor": "{vars.none}",
        "thickness": 1
      }
    },
    "dialog": {
      "base": {
        "shape": "{vars.rLg}",
        "panelBackground": "{vars.card}",
        "panelBorderColor": "{vars.border}",
        "panelBorderWidth": 1,
        "panelGlowColor": "{vars.none}",
        "panelBottomRimColor": null,
        "panelShadowElevation": 18,
        "panelShadowColor": "{vars.shadow}",
        "titleBarBackground": "{vars.card}",
        "titleBarForeground": "{vars.fg}",
        "titleBarBorderColor": "{vars.none}",
        "titleBarDividerThickness": 0,
        "footerBackground": "{vars.card}",
        "footerBorderColor": "{vars.none}",
        "footerDividerThickness": 0,
        "scrimColor": "#00000080",
        "descriptionForeground": "{vars.mutedFg}",
        "closeCapBackground": "{vars.none}",
        "closeCapForeground": "{vars.mutedFg}",
        "closeCapBorderColor": "{vars.none}",
        "closeCapBorderWidth": 0,
        "closeCapGlowColor": "{vars.none}",
        "closeCapShape": "{vars.rSm}",
        "closeCapElevation": 0,
        "closeCapRaisedElevation": 0,
        "closeCapPressedElevation": 0,
        "closeCapTint": "{vars.none}",
        "closeCapFocusBorderColor": "{vars.ring}",
        "closeScaleHover": 1,
        "closeScalePressed": 1
      },
      "states": {
        "hovered": {
          "closeCapBackground": "{vars.muted}",
          "closeCapForeground": "{vars.fg}"
        },
        "pressed": {
          "closeCapBackground": "{vars.muted}",
          "closeCapForeground": "{vars.fg}"
        },
        "focused": {
          "closeCapForeground": "{vars.fg}"
        }
      }
    },
    "dropdownMenu": {
      "base": {
        "panelBackground": "{vars.card}",
        "panelShape": "{vars.r}",
        "panelBorderColor": "{vars.border}",
        "panelBorderWidth": 1,
        "panelGlowColor": "{vars.none}",
        "panelShadowElevation": 6,
        "panelShadowColor": "{vars.shadow}",
        "iconSize": 16,
        "itemShape": "{vars.rSm}",
        "itemForeground": "{vars.fg}",
        "itemActiveBackground": "{vars.muted}",
        "itemSelectedBackground": "{vars.muted}",
        "itemActiveForeground": "{vars.fg}",
        "itemActiveElevation": 0,
        "itemHoverScale": 1,
        "itemPressedScale": 1,
        "itemMutedForeground": "{vars.mutedFg}",
        "groupLabelForeground": "{vars.mutedFg}",
        "separatorBrush": "{vars.border}",
        "separatorThickness": 1,
        "itemBorderColor": "{vars.none}",
        "itemBorderWidth": 0,
        "itemGlowColor": "{vars.none}",
        "itemActiveBorderColor": "{vars.none}",
        "itemOrbColor": null,
        "itemBottomRimColor": null,
        "itemShadowColor": "{vars.none}",
        "itemOverlayBrush": "{vars.none}",
        "itemIconTint": "{vars.mutedFg}",
        "itemDestructiveBackground": "{vars.muted}",
        "itemDestructiveForeground": "{vars.destructive}"
      },
      "states": {
        "hovered": {
          "itemIconTint": "{vars.fg}",
          "itemBackground": "{vars.muted}"
        },
        "focused": {
          "itemIconTint": "{vars.fg}",
          "itemBackground": "{vars.muted}"
        },
        "pressed": {
          "itemIconTint": "{vars.fg}",
          "itemBackground": "{vars.muted}"
        },
        "selected": {
          "itemIconTint": "{vars.fg}",
          "itemBackground": "{vars.muted}"
        }
      }
    },
    "tooltip": {
      "base": {
        "background": "{vars.primary}",
        "foreground": "{vars.primaryFg}",
        "shape": "{vars.r}",
        "borderWidth": 0,
        "shadowElevation": 0
      }
    },
    "tabGroup": {
      "base": {
        "listBackground": "{vars.muted}",
        "listShape": "{vars.r}",
        "listBorderColor": "{vars.none}",
        "listBorderWidth": 0,
        "listShadowElevation": 0,
        "tabShape": "{vars.rSm}",
        "selectedTabBackground": "{vars.bg}",
        "selectedTabForeground": "{vars.fg}",
        "unselectedTabForeground": "{vars.mutedFg}",
        "selectedTabBorderColor": "{vars.none}",
        "tabGlowColor": "{vars.none}",
        "tabElevation": 1,
        "tabHoverScale": 1,
        "tabPressedScale": 1
      }
    },
    "segmentedButton": {
      "base": {
        "background": "{vars.bg}",
        "foreground": "{vars.fg}",
        "borderColor": "{vars.border}",
        "borderWidth": 1,
        "shadowElevation": 0,
        "interactionOverlay": "{vars.none}",
        "interactionRim": "{vars.none}",
        "motion": {
          "hoverScale": 1,
          "pressedScale": 1
        }
      },
      "states": {
        "hovered": {
          "background": "{vars.muted}"
        },
        "selected": {
          "background": "{vars.muted}"
        }
      }
    },
    "scrollbar": {
      "base": {
        "trackBackground": "{vars.none}",
        "thumbBackground": "{vars.border}",
        "thumbBorderColor": "{vars.none}",
        "thumbInnerGlowColor": "{vars.none}",
        "thumbBottomRimColor": null,
        "trackInnerGlowColor": "{vars.none}",
        "trackBottomRimColor": null,
        "thumbInteractionOverlay": "{vars.none}"
      },
      "states": {
        "hovered": {
          "thumbBackground": "{vars.mutedFg}"
        },
        "pressed": {
          "thumbBackground": "{vars.mutedFg}"
        }
      }
    },
    "snackbar": {
