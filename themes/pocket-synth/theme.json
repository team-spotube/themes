{
  "schema": 1,
  "id": "pocket-synth",
  "name": "Pocket Synth",
  "version": "1.0.0",
  "author": "Spotube Team",
  "description": "A palm-sized hardware sampler: chunky keys that sit on the panel, a pale LCD and one loud key colour.",
  "repository": "https://github.com/team-spotube/themes",
  "bugs": "https://github.com/team-spotube/themes/issues",
  "license": "AGPL-3.0-or-later",
  "logo": "logo.png",
  "parameters": {
    "keys": {
      "type": "enum",
      "label": "Key color",
      "default": "orange",
      "options": [
        {
          "value": "orange",
          "label": "Orange",
          "color": "#ff5a1f"
        },
        {
          "value": "blue",
          "label": "Blue",
          "color": "#2f6bff"
        },
        {
          "value": "green",
          "label": "Green",
          "color": "#18a058"
        },
        {
          "value": "pink",
          "label": "Pink",
          "color": "#ff4f8b"
        }
      ]
    }
  },
  "vars": {
    "none": {
      "type": "color",
      "default": "#00000000"
    },
    "key": {
      "type": "color",
      "value": [
        "match",
        "{params.keys}",
        {
          "orange": "#ff5a1f",
          "blue": "#2f6bff",
          "green": "#18a058",
          "pink": "#ff4f8b"
        }
      ]
    },
    "keyDown": {
      "type": "color",
      "value": [
        "darken",
        "{vars.key}",
        0.22
      ]
    },
    "keyHi": {
      "type": "color",
      "value": [
        "lighten",
        "{vars.key}",
        0.2
      ]
    },
    "panel": {
      "type": "color",
      "value": {
        "light": "#dcd8c8",
        "dark": "#2b2b2e"
      }
    },
    "panelLo": {
      "type": "color",
      "value": {
        "light": "#cdc8b6",
        "dark": "#222225"
      }
    },
    "capTop": {
      "type": "color",
      "value": {
        "light": "#fbfaf4",
        "dark": "#4a4a50"
      }
    },
    "capBot": {
      "type": "color",
      "value": {
        "light": "#e6e2d3",
        "dark": "#38383d"
      }
    },
    "capEdge": {
      "type": "color",
      "value": {
        "light": "#a9a490",
        "dark": "#101012"
      }
    },
    "seat": {
      "type": "color",
      "value": {
        "light": "#9c977f",
        "dark": "#0a0a0b"
      }
    },
    "lcd": {
      "type": "color",
      "value": {
        "light": "#c8d1b3",
        "dark": "#a9b88f"
      }
    },
    "lcdInk": {
      "type": "color",
      "value": "#1f2a14"
    },
    "ink": {
      "type": "color",
      "value": {
        "light": "#26241d",
        "dark": "#ecebe4"
      }
    },
    "dim": {
      "type": "color",
      "value": {
        "light": "#6e6a58",
        "dark": "#a3a396"
      }
    },
    "wash": {
      "type": "color",
      "value": {
        "light": "#00000012",
        "dark": "#ffffff14"
      }
    }
  },
  "tokens": {
    "color": {
      "background": "{vars.panel}",
      "surface": "{vars.panelLo}",
      "raised": "{vars.capTop}",
      "inset": "{vars.lcd}",
      "text": "{vars.ink}",
      "muted": "{vars.dim}",
      "border": "{vars.capEdge}",
      "highlight": "#ffffff80",
      "accent": "{vars.key}",
      "accentTop": "{vars.keyHi}",
      "accentBottom": "{vars.keyDown}",
      "onAccent": "#ffffff",
      "success": "#18a058",
      "danger": "#e0302c",
      "scrim": "#00000070"
    },
    "shape": {
      "small": 4,
      "medium": 6,
      "large": 10
    },
    "type": {
      "family": "Space Mono",
      "scale": 0.92
    },
    "interaction": {
      "lighting": false
    },
    "surface": {
      "shadows": false,
      "glow": false
    },
    "app": {
      "background": [
        "linear",
        180,
        {
          "light": "#e3dfd0",
          "dark": "#323236"
        },
        {
          "light": "#cfcab8",
          "dark": "#242427"
        }
      ]
    }
  },
  "defaults": {
    "shape": 6
  },
  "components": {
    "button": {
      "base": {
        "shadows": [
          "#00000000"
