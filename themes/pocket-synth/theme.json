        "shadowElevation": 0,
        "innerGlowColor": "#ffffffa0",
        "bottomRimColor": "{vars.seat}",
        "interactionOverlay": "#00000000",
        "interactionRim": "#00000000",
        "motion": {
          "hoverScale": 1,
          "pressedScale": 0.985
