        "borderWidth": 1,
        "background": [
          "linear",
          180,
          "{vars.capTop}",
          "{vars.capBot}"
        ],
        "foreground": "{vars.ink}",
        "borderColor": "{vars.capEdge}",
        "shape": 6,
        "padding": [
          18,
          11
        ],
        "textStyle": {
          "fontFamily": "Space Mono",
          "fontWeight": 700,
          "fontSize": 13
        }
      },
      "states": {
        "hovered": {
          "background": [
            "linear",
            180,
            "#ffffff",
            "{vars.capBot}"
          ]
        },
        "pressed": {
