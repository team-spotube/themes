{
  "schema": 1,
  "id": "brutalist",
  "name": "Brutal",
  "version": "1.0.0",
  "author": "Spotube Team",
  "description": "Thick black outlines, loud flat colour and heavy type with no softness anywhere. Hover floods controls with the accent.",
  "repository": "https://github.com/team-spotube/themes",
  "bugs": "https://github.com/team-spotube/themes/issues",
  "license": "AGPL-3.0-or-later",
  "logo": "logo.png",
  "parameters": {
    "paint": {
      "type": "enum",
      "label": "Color",
      "default": "yellow",
      "options": [
        {
          "value": "yellow",
          "label": "Yellow",
          "color": "#ffe14d"
        },
        {
          "value": "pink",
          "label": "Pink",
          "color": "#ff6bd6"
        },
        {
          "value": "blue",
          "label": "Blue",
          "color": "#6aa9ff"
        },
        {
          "value": "lime",
          "label": "Lime",
          "color": "#b6f23a"
        },
        {
          "value": "red",
          "label": "Red",
          "color": "#ff5a3c"
        }
      ]
    },
    "weight": {
      "type": "number",
      "label": "Outline thickness",
      "default": 3,
      "min": 1,
      "max": 5,
      "step": 1
    }
  },
  "vars": {
    "none": {
      "type": "color",
      "default": "#00000000"
    },
    "paint": {
      "type": "color",
      "value": [
        "match",
        "{params.paint}",
        {
          "yellow": "#ffe14d",
          "pink": "#ff6bd6",
          "blue": "#6aa9ff",
          "lime": "#b6f23a",
          "red": "#ff5a3c"
        }
      ]
    },
    "ink": {
      "type": "color",
      "value": {
        "light": "#111111",
        "dark": "#f5f5f0"
      }
    },
    "paper": {
      "type": "color",
      "value": {
        "light": "#fffdf2",
        "dark": "#141414"
      }
    },
    "paper2": {
      "type": "color",
      "value": {
        "light": "#f1eed9",
        "dark": "#1f1f1f"
      }
    },
    "onPaint": {
      "type": "color",
      "value": "#111111"
    },
    "line": {
      "type": "color",
      "value": {
        "light": "#111111",
        "dark": "#f5f5f0"
      }
    },
    "w": {
      "type": "number",
      "value": "{params.weight}"
    }
  },
  "tokens": {
    "color": {
      "background": "{vars.paper}",
      "surface": "{vars.paper}",
      "raised": "{vars.paper2}",
      "inset": "{vars.paper2}",
      "text": "{vars.ink}",
      "muted": {
        "light": "#4a4a42",
        "dark": "#b5b5aa"
      },
      "border": "{vars.line}",
      "highlight": "#00000000",
      "accent": "{vars.paint}",
      "accentTop": "{vars.paint}",
      "accentBottom": "{vars.paint}",
      "onAccent": "#111111",
      "success": "#3ddc84",
      "danger": "#ff3b30",
      "scrim": {
        "light": "#11111180",
        "dark": "#000000b0"
      }
    },
    "shape": {
      "small": 0,
      "medium": 0,
      "large": 0
    },
    "type": {
      "family": "Space Mono",
      "scale": 0.95,
      "styles": {
        "displaySmall": {
          "fontFamily": "Archivo Black"
        },
        "headlineLarge": {
          "fontFamily": "Archivo Black"
        },
        "headlineMedium": {
          "fontFamily": "Archivo Black"
        },
        "headlineSmall": {
          "fontFamily": "Archivo Black"
        },
        "titleLarge": {
          "fontFamily": "Archivo Black"
        },
        "titleMedium": {
          "fontFamily": "Archivo Black"
        }
      }
    },
    "interaction": {
      "lighting": false
    },
    "surface": {
      "shadows": false,
      "glow": false
    },
    "app": {
      "background": [
        "gradient",
        "{vars.paper}",
        "{vars.paper}"
      ]
    }
  },
  "defaults": {
    "shape": "rect"
  },
