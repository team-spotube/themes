{
  "$schema": "https://docs.spotube.cc/schemas/theme/1.json",
  "schema": "1.0.0",
  "id": "candy-pop",
  "name": "Candy Pop",
  "version": "2.0.0",
  "author": "Spotube Team",
  "description": "Sweets on a pastel gradient: fat glossy pills with a thick under-edge, bouncy presses and a round typeface. Dark is night-time candy.",
  "repository": "https://github.com/team-spotube/themes",
  "bugs": "https://github.com/team-spotube/themes/issues",
  "license": "AGPL-3.0-or-later",
  "logo": "logo.png",
  "parameters": {
    "flavor": {
      "type": "enum",
      "label": "Flavor",
      "default": "bubblegum",
      "options": [
        {
          "value": "bubblegum",
          "label": "Bubblegum",
          "color": "#ff4fa3"
        },
        {
          "value": "mint",
          "label": "Mint",
          "color": "#19c9a0"
        },
        {
          "value": "grape",
          "label": "Grape",
          "color": "#9b5cf6"
        },
        {
          "value": "lemon",
          "label": "Lemon",
          "color": "#f5b800"
        },
        {
          "value": "berry",
          "label": "Berry",
          "color": "#ff5a5f"
        }
      ]
    }
  },
  "vars": {
    "none": {
      "type": "color",
      "default": "#00000000"
    },
    "sweet": {
      "type": "color",
      "value": [
        "match",
        "{params.flavor}",
        {
          "bubblegum": "#ff4fa3",
          "mint": "#19c9a0",
          "grape": "#9b5cf6",
          "lemon": "#f5b800",
          "berry": "#ff5a5f"
        }
      ]
    },
    "sweetHi": {
      "type": "color",
      "value": [
        "lighten",
        "{vars.sweet}",
        0.28
      ]
    },
    "sweetLo": {
      "type": "color",
      "value": [
        "darken",
        "{vars.sweet}",
        0.22
      ]
    },
    "onSweet": {
      "type": "color",
      "value": [
        "match",
        "{params.flavor}",
        {
          "bubblegum": "#ffffff",
          "mint": "#053b2f",
          "grape": "#ffffff",
          "lemon": "#4a3400",
          "berry": "#ffffff"
        }
      ]
    },
    "cream": {
      "type": "color",
      "value": {
        "light": "#ffffff",
        "dark": "#3a2f5c"
      }
    },
    "creamLo": {
      "type": "color",
      "value": {
        "light": "#ffe3f1",
        "dark": "#2c2347"
      }
    },
    "creamEdge": {
      "type": "color",
      "value": {
        "light": "#f0b6d3",
        "dark": "#18112e"
      }
    },
    "ink": {
      "type": "color",
      "value": {
        "light": "#5a2347",
        "dark": "#fff0f8"
      }
    },
    "dim": {
      "type": "color",
      "value": {
        "light": "#a45a86",
        "dark": "#c4aee0"
      }
    },
    "wash": {
      "type": "color",
      "value": [
        "alpha",
        "{vars.sweet}",
        0.2
      ]
    },
    "soft": {
      "type": "color",
      "value": [
        "alpha",
        "{vars.sweet}",
        0.45
      ]
    }
  },
  "tokens": {
    "color": {
      "background": {
        "light": "#fff0f8",
        "dark": "#241a40"
      },
      "surface": "{vars.cream}",
      "raised": "{vars.creamLo}",
      "inset": "{vars.creamLo}",
      "text": "{vars.ink}",
      "muted": "{vars.dim}",
      "border": "{vars.creamEdge}",
      "highlight": "#ffffffc0",
      "accent": "{vars.sweet}",
      "accentTop": "{vars.sweetHi}",
      "accentBottom": "{vars.sweetLo}",
      "onAccent": "{vars.onSweet}",
      "success": "#19c9a0",
      "danger": "#ff5a5f",
      "scrim": {
        "light": "#5a234760",
        "dark": "#0f0820b0"
      }
    },
    "shape": {
      "small": 14,
      "medium": 20,
      "large": 32
    },
    "type": {
      "family": "Comfortaa"
    },
    "app": {
      "background": [
        "linear",
        160,
        {
          "light": "#ffe3f4",
          "dark": "#2a1d4d"
        },
        {
          "light": "#efe3ff",
          "dark": "#231a40"
        },
        {
          "light": "#ddf1ff",
          "dark": "#1a2a4a"
        }
      ]
    }
  },
  "defaults": {
    "shape": 20
  },
  "components": {
    "button": {
      "base": {
        "shadows": [
          "#5a234722"
        ],
        "shadowElevation": 8,
        "innerGlowColor": "#ffffffff",
