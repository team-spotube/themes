{
  "schema": 1,
  "id": "candy-pop",
  "name": "Candy Pop",
  "version": "1.1.0",
  "author": "Spotube Team",
  "description": "Soft pastel gloss with fully rounded shapes and the friendly Comfortaa typeface.",
  "repository": "https://github.com/team-spotube/themes",
  "bugs": "https://github.com/team-spotube/themes/issues",
  "homepage": "https://github.com/alexeiva/comfortaa",
  "license": "AGPL-3.0 (theme), OFL-1.1 (Comfortaa)",
  "logo": "logo.png",
  "assets": {
    "fonts": {
      "Comfortaa": [
        {
          "src": "fonts/Comfortaa-Regular.otf",
          "weight": 400
        },
        {
          "src": "fonts/Comfortaa-Bold.otf",
          "weight": 700
        }
      ]
    }
  },
  "parameters": {
    "accent": {
      "type": "enum",
      "label": "Flavor",
      "default": "pink",
      "options": [
        {
          "value": "pink",
          "label": "Pink",
          "color": "#ff5c9e"
        },
        {
          "value": "peach",
          "label": "Peach",
          "color": "#ff8a5c"
        },
        {
          "value": "mint",
          "label": "Mint",
          "color": "#10b981"
        },
        {
          "value": "lavender",
          "label": "Lavender",
          "color": "#8b5cf6"
        }
      ]
    },
    "radius": {
      "type": "number",
      "label": "Corner radius",
      "default": 20,
      "min": 0,
      "max": 32,
      "step": 2
    }
  },
  "vars": {
    "soft": {
      "type": "color",
      "value": [
        "match",
        "{params.accent}",
        {
          "pink": "#ffb3d1",
          "peach": "#ffcfb0",
          "mint": "#b6f0d4",
          "lavender": "#d9ccff"
        }
      ]
    },
    "main": {
      "type": "color",
      "value": [
        "match",
        "{params.accent}",
        {
          "pink": "#ff5c9e",
          "peach": "#ff8a5c",
          "mint": "#10b981",
          "lavender": "#8b5cf6"
        }
      ]
    },
    "deep": {
      "type": "color",
      "value": [
        "match",
        "{params.accent}",
        {
          "pink": "#e63d82",
          "peach": "#e5683a",
          "mint": "#059669",
          "lavender": "#6d3fd6"
        }
      ]
    },
    "bgc": {
      "type": "color",
      "value": [
        "match",
        "{params.accent}",
        {
          "pink": {
            "light": "#fff4f8",
            "dark": "#1e1118"
          },
          "peach": {
            "light": "#fff6f0",
            "dark": "#1f130e"
          },
          "mint": {
            "light": "#f1fcf7",
            "dark": "#0e1a15"
          },
          "lavender": {
            "light": "#f7f3ff",
            "dark": "#15101f"
          }
        }
      ]
    },
    "insetc": {
      "type": "color",
      "value": [
        "match",
        "{params.accent}",
        {
          "pink": {
            "light": "#ffe8f1",
            "dark": "#170c12"
          },
          "peach": {
            "light": "#ffeadd",
            "dark": "#170d09"
          },
          "mint": {
            "light": "#e1f8ee",
            "dark": "#09130f"
          },
          "lavender": {
            "light": "#ece5ff",
            "dark": "#0f0a17"
          }
        }
      ]
    },
    "line": {
      "type": "color",
      "value": [
        "match",
        "{params.accent}",
        {
          "pink": {
            "light": "#f3c4d8",
            "dark": "#5a3447"
          },
          "peach": {
            "light": "#f5cdb6",
            "dark": "#5a3b2a"
          },
          "mint": {
            "light": "#bfe6d4",
            "dark": "#27483b"
          },
          "lavender": {
            "light": "#d8ccf3",
            "dark": "#3d3159"
          }
        }
      ]
    },
    "ink": {
      "type": "color",
      "value": [
        "match",
        "{params.accent}",
        {
          "pink": {
            "light": "#4a2a3b",
            "dark": "#ffeaf3"
          },
          "peach": {
            "light": "#4a2e22",
            "dark": "#ffeee3"
          },
          "mint": {
            "light": "#1d3b30",
            "dark": "#e2fff3"
          },
          "lavender": {
            "light": "#33264f",
            "dark": "#efe9ff"
          }
        }
      ]
    },
    "inkMuted": {
      "type": "color",
      "value": [
        "match",
        "{params.accent}",
        {
          "pink": {
            "light": "#9a6b83",
            "dark": "#c79ab2"
          },
          "peach": {
            "light": "#9a7258",
            "dark": "#c9a48c"
          },
          "mint": {
            "light": "#5d8f7b",
            "dark": "#8fc7ad"
          },
          "lavender": {
            "light": "#7d6aa8",
            "dark": "#b6a2de"
          }
        }
      ]
    },
    "wash": {
      "type": "color",
      "value": [
        "alpha",
        "{vars.main}",
        0.14
      ]
    },
    "glow": {
      "type": "color",
      "value": [
        "alpha",
        "{vars.main}",
        0.35
      ]
    },
    "surfaceC": {
      "type": "color",
      "value": {
        "light": "#ffffff",
        "dark": "#2a1822"
      }
    },
    "r": {
      "type": "number",
      "value": "{params.radius}"
    },
    "rXl": {
      "type": "number",
      "value": [
        "add",
        "{params.radius}",
        4
      ]
    },
    "rField": {
      "type": "number",
      "value": [
        "max",
        0,
        [
          "sub",
          "{params.radius}",
          2
        ]
      ]
    }
  },
  "tokens": {
    "color": {
      "background": "{vars.bgc}",
      "surface": "{vars.surfaceC}",
      "raised": {
        "light": "#fffafc",
        "dark": "#35202b"
      },
      "inset": "{vars.insetc}",
      "text": "{vars.ink}",
      "muted": "{vars.inkMuted}",
      "border": "{vars.line}",
      "highlight": "#ffffff",
      "accent": "{vars.main}",
      "accentTop": "{vars.soft}",
      "accentBottom": "{vars.deep}",
      "onAccent": "#ffffff",
      "success": {
        "light": "#2fb67f",
        "dark": "#5be3a8"
      },
      "danger": {
        "light": "#e8435f",
        "dark": "#ff7d92"
      }
    },
    "shape": {
      "small": 12,
      "medium": "{vars.r}",
      "large": 28
    },
    "type": {
      "family": "Comfortaa"
    }
  },
  "defaults": {
    "shape": "{vars.r}"
  },
  "components": {
    "button": {
      "base": {
        "textStyle": {
          "fontWeight": 700
        },
        "borderWidth": 1
      },
      "variants": {
        "primary": {
          "base": {
            "shape": "pill",
            "background": [
              "linear",
              180,
              "{vars.soft}",
              "{vars.main}"
            ],
            "borderColor": "{vars.deep}",
            "foreground": "#ffffff",
            "innerGlowColor": "#ffffffb0",
            "shadows": [
              "{vars.glow}"
            ],
            "shadowElevation": 8,
            "textStyle": {
              "shadow": {
                "color": "#00000040",
                "offsetY": 1,
                "blurRadius": 1
              }
            }
          },
          "states": {
            "hovered": {
              "background": [
                "linear",
                180,
                "{vars.soft}",
                "{vars.soft}",
                "{vars.main}"
              ],
              "shadowElevation": 12
            },
            "pressed": {
              "background": [
                "linear",
                180,
                "{vars.main}",
                "{vars.soft}"
              ],
              "shadowElevation": 2,
              "motion": {
                "pressedScale": 0.94
              }
            }
          }
        },
        "secondary": {
          "base": {
            "shape": "pill",
            "borderColor": "{vars.soft}",
            "foreground": "{vars.ink}",
            "background": [
              "linear",
              180,
              "{tokens.color.surface}",
              "{tokens.color.inset}"
            ],
            "innerGlowColor": "#ffffffd0",
            "shadows": [
              "{vars.glow}"
            ],
            "shadowElevation": 4
          },
          "states": {
            "hovered": {
              "borderColor": "{vars.main}"
            }
          }
        },
        "quiet": {
          "base": {
            "shape": "pill",
            "foreground": "{vars.deep}"
          },
          "states": {
            "hovered": {
              "background": [
                "gradient",
                "{vars.wash}",
                "{vars.wash}"
              ],
              "borderColor": "{vars.soft}"
            }
          }
        },
        "danger": {
          "base": {
            "shape": "pill",
            "background": [
              "linear",
              180,
              "#ff9aa8",
              "#e8435f"
            ],
            "borderColor": "#c92f4a",
            "foreground": "#ffffff",
            "innerGlowColor": "#ffffffa0",
            "shadows": [
              "#e8435f55"
            ],
            "shadowElevation": 8
          }
        }
      }
    },
    "iconButton": {
      "base": {
        "shape": "pill",
        "orb": false
      },
      "variants": {
        "primary": {
          "base": {
            "background": [
              "linear",
              180,
              "{vars.soft}",
              "{vars.main}"
            ],
            "borderColor": "{vars.deep}",
            "borderWidth": 1,
            "foreground": "#ffffff",
            "innerGlowColor": "#ffffffb0",
            "shadows": [
              "{vars.glow}"
            ],
            "shadowElevation": 6
          }
        },
        "secondary": {
          "base": {
            "background": [
              "linear",
              180,
              "{tokens.color.surface}",
              "{tokens.color.inset}"
            ],
            "borderColor": "{vars.soft}",
            "borderWidth": 1
          }
        },
        "danger": {
          "base": {
            "background": [
              "linear",
              180,
              "#ff9aa8",
              "#e8435f"
            ],
            "borderColor": "#c92f4a",
            "borderWidth": 1,
            "foreground": "#ffffff"
          }
        }
      }
    },
    "toggleSwitch": {
      "base": {
        "trackBackground": [
          "linear",
          180,
          "{tokens.color.inset}",
          "{tokens.color.surface}"
        ],
        "trackBorderColor": "{vars.soft}",
        "trackShape": "pill",
        "selectedTrackBackground": [
          "linear",
          180,
          "{vars.soft}",
          "{vars.main}"
        ],
        "thumbShape": "pill",
        "thumbBackground": [
          "linear",
          180,
          "#ffffff",
          "#ffe3ee"
        ],
        "thumbBorderColor": "{vars.soft}",
        "thumbBorderWidth": 1,
        "trackSize": [
          50,
          30
        ]
      },
      "states": {
        "selected": {
          "trackBorderColor": "{vars.deep}"
        }
      }
    },
    "checkbox": {
      "base": {
        "faceShape": 9,
        "faceBackground": [
          "linear",
          180,
          "{tokens.color.surface}",
          "{tokens.color.inset}"
        ],
        "faceBorderColor": "{vars.soft}",
        "faceBorderWidth": 1.5,
        "selectedFaceBackground": [
          "linear",
          180,
          "{vars.soft}",
          "{vars.main}"
        ],
        "selectedFaceBorderColor": "{vars.deep}",
        "selectedFaceForeground": "#ffffff",
        "selectedFaceGlowColor": "{vars.glow}"
      }
    },
    "slider": {
      "base": {
        "trackShape": "pill",
        "trackBackground": [
          "linear",
          180,
          "{tokens.color.inset}",
          "{tokens.color.surface}"
        ],
        "trackBorderColor": "{vars.soft}",
        "activeTrackBackground": [
          "linear",
          180,
          "{vars.soft}",
          "{vars.main}"
        ],
        "activeTrackShape": "pill",
        "thumbShape": "pill",
        "thumbBackground": [
          "linear",
          180,
          "#ffffff",
          "#ffe3ee"
        ],
        "thumbBorderColor": "{vars.main}",
        "thumbBorderWidth": 2,
        "thumbGlowColor": "{vars.glow}",
        "thumbBottomRimColor": null
      }
    },
    "progress": {
      "base": {
        "shape": "pill",
        "trackBackground": [
          "linear",
          180,
          "{tokens.color.inset}",
          "{tokens.color.surface}"
        ],
        "borderColor": "{vars.soft}",
        "progressBackground": [
          "linear",
          90,
          "{vars.soft}",
          "{vars.main}"
        ],
        "progressShape": "pill",
        "innerGlowColor": "#ffffff90"
      }
    },
    "textField": {
      "base": {
        "background": [
          "gradient",
          "{tokens.color.inset}",
          "{tokens.color.surface}"
        ],
        "borderColor": "{vars.soft}",
        "shape": "{vars.rField}",
        "cursorColor": "{vars.main}"
      },
      "states": {
        "focused": {
          "borderColor": "{vars.main}",
          "borderWidth": 2
        }
      }
    },
    "card": {
      "base": {
        "shape": "{vars.rXl}",
        "background": [
          "linear",
          180,
          "{tokens.color.surface}",
          "{tokens.color.raised}"
        ],
        "borderColor": "{vars.soft}",
        "shadowElevation": 10,
        "shadowColor": "{vars.glow}",
        "innerGlowColor": "#ffffffc0"
      }
    },
    "listTile": {
      "base": {
        "shape": 16,
        "selectedBackground": [
          "linear",
          90,
          "{vars.wash}",
          "#ffffff00"
        ]
      }
    }
  }
}
