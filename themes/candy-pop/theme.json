        "borderWidth": 0,
        "background": [
          "linear",
          180,
          "{vars.cream}",
          "{vars.creamLo}"
        ],
        "foreground": "{vars.ink}",
        "shape": "pill",
        "padding": [
          26,
          13
        ],
        "textStyle": {
          "fontWeight": 700,
          "fontSize": 14
        },
        "labelShadow": false
      },
      "states": {
        "pressed": {
          "bottomRimColor": null,
