{
  "name": "spotube-themes",
  "version": "1.1.0",
  "private": true,
  "description": "The official Spotube themes, built with @team-spotube/theme-tool.",
  "license": "AGPL-3.0-or-later",
  "keywords": ["spotube-theme"],
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "tool": "pnpm --filter @team-spotube/theme-tool build && pnpm --filter create-spotube-theme build",
    "build": "spotube-theme build",
    "check": "spotube-theme check",
    "zip": "spotube-theme zip",
    "dist": "spotube-theme dist",
    "typecheck": "tsc --noEmit",
    "icons": "pnpm --filter @team-spotube/theme-tool icons",
    "templates": "pnpm --filter @team-spotube/theme-tool templates"
  },
  "devDependencies": {
    "@team-spotube/theme-tool": "workspace:*",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
